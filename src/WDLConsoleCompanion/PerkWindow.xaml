<Window x:Class="WDLConsoleCompanion.PerkWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Experimental Perk Editor" Width="900" Height="650" MinWidth="650" MinHeight="460">
  <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Background="#3B2026" BorderBrush="#B64C5D" BorderThickness="1" CornerRadius="5" Padding="12" Margin="0,0,0,12"><StackPanel><TextBlock Text="EXPERIMENTAL — CRASH AND SAVE-CORRUPTION RISK" Foreground="#FF7A8A" FontWeight="Bold"/><TextBlock Text="Existing hashes are resolved to names below. Back up your save. Maximum 80 perks." TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></Border>
    <Grid Grid.Row="1" Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <ComboBox x:Name="PerkPicker" IsEditable="True" IsTextSearchEnabled="True" TextSearch.TextPath="SearchText" MaxDropDownHeight="300" Background="#131823" Foreground="{StaticResource TextBrush}" Padding="8">
        <ComboBox.ItemContainerStyle><Style TargetType="ComboBoxItem"><Setter Property="Background" Value="#131823"/><Setter Property="Foreground" Value="#E8EEF8"/><Setter Property="Padding" Value="7,5"/></Style></ComboBox.ItemContainerStyle>
      </ComboBox><Button Grid.Column="1" Content="Add selected perk" Click="AddPerk_Click"/>
    </Grid>
    <DataGrid x:Name="PerkGrid" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" RowBackground="#111722" AlternatingRowBackground="#151C28" Background="{StaticResource PanelBrush}" Foreground="{StaticResource TextBrush}">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Perk name" Binding="{Binding Name}" IsReadOnly="True" Width="220"/>
        <DataGridTextColumn Header="Hash" Binding="{Binding Code}" IsReadOnly="True" Width="105"/>
        <DataGridTextColumn Header="Description" Binding="{Binding Description}" IsReadOnly="True" Width="*"/>
        <DataGridTemplateColumn Width="85"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="Remove" Tag="{Binding}" Click="RemovePerk_Click"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>
    <Grid Grid.Row="3" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="Footer" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/><Button Grid.Column="1" Content="Reload" Click="Reload_Click"/><Button Grid.Column="2" Content="Save perks (risky)" Background="#4A202A" BorderBrush="#B64C5D" Click="Save_Click"/></Grid>
  </Grid>
</Window>
