<Window Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}" x:Class="WDLConsoleCompanion.PerkWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Experimental Perk Editor" Width="1020" Height="700" MinWidth="760" MinHeight="500">
  <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Background="#3B2026" BorderBrush="#B64C5D" BorderThickness="1" CornerRadius="5" Padding="12" Margin="0,0,0,12"><StackPanel><TextBlock Text="EXPERIMENTAL — CRASH AND SAVE-CORRUPTION RISK" Foreground="#FF7A8A" FontWeight="Bold"/><TextBlock Text="Every perk currently stored on the selected operative is listed as CURRENT below. Search by readable name, internal name, description, or hash. Back up your save." TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></Border>
    <Grid Grid.Row="1" Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <TextBlock Text="Search all perks" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold"/>
      <Grid Grid.Column="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBox x:Name="PerkSearch" TextChanged="PerkSearch_TextChanged" ToolTip="Search readable name, internal name, description, or hexadecimal hash"/>
        <TextBlock x:Name="PerkMatchCount" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
      </Grid>
    </Grid>
    <Grid Grid.Row="2" Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <ComboBox x:Name="PerkPicker" IsEditable="False" IsTextSearchEnabled="False" MaxDropDownHeight="340" Background="{DynamicResource InputBrush}" Foreground="{DynamicResource InputTextBrush}" Padding="8">
        <ComboBox.ItemContainerStyle><Style TargetType="ComboBoxItem"><Setter Property="Background" Value="{DynamicResource InputBrush}"/><Setter Property="Foreground" Value="{DynamicResource InputTextBrush}"/><Setter Property="Padding" Value="7,5"/></Style></ComboBox.ItemContainerStyle>
      </ComboBox><Button Grid.Column="1" Content="Add selected perk" Click="AddPerk_Click"/>
    </Grid>
    <DataGrid x:Name="PerkGrid" Grid.Row="3" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" RowBackground="{DynamicResource RowBrush}" AlternatingRowBackground="{DynamicResource AlternateRowBrush}" Background="{DynamicResource PanelBrush}" Foreground="{DynamicResource TextBrush}" RowHeight="44">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Status" Binding="{Binding Status}" IsReadOnly="True" Width="82"/>
        <DataGridTextColumn Header="Readable perk name" Binding="{Binding Name}" IsReadOnly="True" Width="245"/>
        <DataGridTextColumn Header="Hash" Binding="{Binding Code}" IsReadOnly="True" Width="105"/>
        <DataGridTextColumn Header="Internal game name" Binding="{Binding InternalName}" IsReadOnly="True" Width="220"/>
        <DataGridTextColumn Header="Description" Binding="{Binding Description}" IsReadOnly="True" Width="*"/>
        <DataGridTemplateColumn Width="85"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="Remove" Tag="{Binding}" Click="RemovePerk_Click"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>
    <Grid Grid.Row="4" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="Footer" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/><Button Grid.Column="1" Content="Reload current perks" Click="Reload_Click"/><Button Grid.Column="2" Content="Save perks (risky)" Background="#4A202A" BorderBrush="#B64C5D" Click="Save_Click"/></Grid>
  </Grid>
</Window>
