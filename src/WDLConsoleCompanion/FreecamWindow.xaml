<Window x:Class="WDLConsoleCompanion.FreecamWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Camera Tools" Width="720" Height="560" MinWidth="620" MinHeight="480"
        Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="20">
      <TextBlock Text="CAMERA TOOLS" FontSize="23" FontWeight="Bold" Foreground="#59D6A2"/>
      <TextBlock Margin="0,6,0,14" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"
                 Text="Photo Mode is a separate, validated camera. The gameplay freecam research below targets a detached camera while normal gameplay, AI, physics, and missions continue."/>

      <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="16" Margin="0,0,0,16">
        <StackPanel>
          <TextBlock Text="BUILT-IN PHOTO MODE — RECOMMENDED" FontSize="17" FontWeight="Bold" Foreground="#59D6A2"/>
          <TextBlock Margin="0,6,0,12" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"
                     Text="This focuses the game and presses F2. It opens Legion's supported flying camera immediately and does not scan or write memory."/>
          <Button Content="Open Photo Mode (F2)" Padding="18,11" HorizontalAlignment="Left" Click="OpenPhotoMode_Click" Background="#176B50"/>
        </StackPanel>
      </Border>

      <Border Background="#402028" BorderBrush="#A94659" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,14">
        <StackPanel>
          <TextBlock Text="TRUE FREECAM — UNDER DEVELOPMENT" FontWeight="Bold" Foreground="#FF9AAA"/>
          <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Text="The normal gameplay camera owner and its per-frame follow writer are not validated yet. Until they are, this build stays read-only for gameplay-camera research and will not risk a camera write."/>
        </StackPanel>
      </Border>

      <Border Background="#3B2630" BorderBrush="#D45A78" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,14">
        <StackPanel>
          <TextBlock Text="EXPERIMENTAL PHASE FLY — NOT A DETACHED CAMERA" FontWeight="Bold" Foreground="#FFB3C3"/>
          <TextBlock Margin="0,6,0,8" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"
                     Text="This is the safer current gameplay test: it keeps the game running and moves the operative through verified coordinates. It does not claim to be CCameraFreeComponent and can still cause falls or save issues. Save a safe location first."/>
          <WrapPanel>
            <Button x:Name="PhaseFlyButton" Content="Enable phase fly" Padding="12,8" Click="PhaseFly_Click" Background="#6C182D"/>
            <Button x:Name="PhaseProbeButton" Content="Probe camera APIs" Padding="12,8" Margin="8,0,0,0" Click="PhaseProbe_Click"/>
            <Button x:Name="PhaseSafeButton" Content="Save safe location" Padding="12,8" Margin="8,0,0,0" Click="PhaseSafe_Click"/>
            <Button x:Name="PhaseReturnButton" Content="Emergency return" Padding="12,8" Margin="8,0,0,0" Click="PhaseReturn_Click"/>
          </WrapPanel>
          <WrapPanel Margin="0,10,0,0">
            <TextBlock Text="Step (m):" VerticalAlignment="Center"/>
            <TextBox x:Name="PhaseStepBox" Text="2" Width="60" Margin="6,0,14,0"/>
            <TextBlock Text="Shift multiplier:" VerticalAlignment="Center"/>
            <TextBox x:Name="PhaseShiftBox" Text="2" Width="60" Margin="6,0,0,0"/>
          </WrapPanel>
          <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"
                     Text="Controls while enabled: W/A/S/D move, Space/Ctrl vertical, Shift applies the multiplier. Escape disables movement. Every move records a reversible safety point."/>
          <TextBlock x:Name="PhaseStatusText" Margin="0,8,0,0" Foreground="#FFB3C3" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>

      <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="14" Margin="0,0,0,14">
        <StackPanel>
          <TextBlock Text="NORMAL GAMEPLAY FOLLOW CAMERA — READ-ONLY VALIDATION" FontWeight="Bold" Foreground="#59D6A2"/>
          <TextBlock Margin="0,6,0,8" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"
                     Text="Static research has mapped a likely normal follow-camera configuration surface (input yaw/pitch, FOV, follow, pivot and collision). After a scan leaves a small candidate set, inspect nearby fields as a possible runtime transform/FOV layout. The live monitor refreshes read-only values four times per second while normal gameplay continues; it does not activate Photo Mode, move the operative, or write game memory."/>
          <WrapPanel>
            <Button x:Name="InspectCandidatesButton" Content="Inspect once" Padding="12,8" Click="InspectCandidates_Click" IsEnabled="False"/>
            <Button x:Name="StartLiveMonitorButton" Content="Start live monitor (4 Hz)" Padding="12,8" Margin="8,0,0,0" Click="StartLiveMonitor_Click" IsEnabled="False"/>
            <Button x:Name="StopLiveMonitorButton" Content="Stop monitor" Padding="12,8" Margin="8,0,0,0" Click="StopLiveMonitor_Click" IsEnabled="False"/>
          </WrapPanel>
          <TextBox x:Name="CandidateInspectorText" Margin="0,10,0,0" Height="130" IsReadOnly="True" IsReadOnlyCaretVisible="True"
                   TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                   Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}"/>
        </StackPanel>
      </Border>

      <Expander Header="Advanced memory calibration (slow, developer tool)" Foreground="{DynamicResource TextBrush}">
        <StackPanel Margin="0,12,0,0">
          <TextBlock Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"
                     Text="Click Arm, return to normal gameplay, unpause and position yourself, then press F8. No memory is written. After F8, automatic direction/stop scans alternate across both axes until the candidate set is small enough to inspect. Keyboard and mouse input stay blocked for the scan except Escape."/>
          <TextBlock Margin="0,7,0,0" Foreground="#F0A44B" FontWeight="SemiBold" TextWrapping="Wrap"
                     Text="TEMPORARY RESEARCH LOGGING: every console message and calibration phase is saved to CSV. Remove/disable this after the camera is found."/>
          <Button x:Name="FullAutomaticButton" Content="Arm automatic calibration — start with F8" Padding="16,10" Margin="0,12,0,0" HorizontalAlignment="Left" Background="#176B50" Click="FullAutomatic_Click"/>
          <WrapPanel Margin="0,12,0,0">
            <Button x:Name="NewCalibrationButton" Content="Start / reset calibration" Padding="12,8" Click="NewCalibration_Click"/>
            <Button x:Name="HorizontalButton" Content="Automatic horizontal discovery" Padding="12,8" Margin="8,0,0,0" Click="HorizontalPass_Click" IsEnabled="False"/>
            <Button x:Name="VerticalButton" Content="Automatic vertical filter" Padding="12,8" Margin="8,0,0,0" Click="VerticalPass_Click" IsEnabled="False"/>
            <Button x:Name="CancelCalibrationButton" Content="Cancel" Padding="12,8" Margin="8,0,0,0" Click="CancelCalibration_Click" IsEnabled="False"/>
          </WrapPanel>
          <ProgressBar x:Name="CalibrationProgress" Height="7" Margin="0,10,0,0" Minimum="0" Maximum="100" Value="0"/>
          <TextBlock x:Name="CandidateText" Margin="0,8,0,10" FontWeight="SemiBold" Text="No calibration is active." TextWrapping="Wrap"/>
          <Button Content="Open manual scanner" Padding="13,8" HorizontalAlignment="Left" Click="OpenScanner_Click" Background="#6C182D"/>
        </StackPanel>
      </Expander>

      <TextBlock x:Name="StatusText" Margin="0,18,0,0" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
    </StackPanel>
  </ScrollViewer>
</Window>
