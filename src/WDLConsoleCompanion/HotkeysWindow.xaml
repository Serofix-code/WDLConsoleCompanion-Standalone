<Window Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}" x:Class="WDLConsoleCompanion.HotkeysWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Keyboard Shortcuts" Width="560" Height="510" ResizeMode="NoResize">
  <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,12"><TextBlock Text="GLOBAL GAMEPLAY SHORTCUTS" FontSize="21" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="Shortcuts work while the companion is running, even when the game has focus. Choose None to disable a binding." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/></StackPanel>
    <DataGrid x:Name="BindingGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False">
      <DataGrid.Columns><DataGridTextColumn Header="Cheat" Binding="{Binding DisplayName}" IsReadOnly="True" Width="*"/><DataGridComboBoxColumn x:Name="KeyColumn" Header="Shortcut" SelectedValueBinding="{Binding Key, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="180"/></DataGrid.Columns>
    </DataGrid>
    <DockPanel Grid.Row="2" Margin="0,12,0,0"><TextBlock x:Name="Footer" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/><Button DockPanel.Dock="Right" Content="Save shortcuts" Click="Save_Click"/></DockPanel>
  </Grid>
</Window>
