<Window Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}" x:Class="WDLConsoleCompanion.SettingsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Settings" Width="560" Height="520" ResizeMode="NoResize">
 <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="SETTINGS" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="Saved in config/settings.json and applied to future sessions." Foreground="{DynamicResource MutedBrush}"/></StackPanel>
  <StackPanel Grid.Row="1" Margin="0,18,0,0">
   <TextBlock Text="Appearance" FontWeight="Bold"/>
   <ComboBox x:Name="ThemeBox" Margin="4,8,4,14"><ComboBoxItem Content="System"/><ComboBoxItem Content="Dark gray" Tag="Dark"/><ComboBoxItem Content="Light"/></ComboBox>
   <TextBlock Text="Attachment" FontWeight="Bold"/>
   <CheckBox x:Name="AutoInjectBox" Content="Automatically attach when the main game and engine are ready" Margin="4,8"/>
   <DockPanel Margin="4"><TextBlock Text="Automatic attach delay (3–60 seconds)" VerticalAlignment="Center"/><TextBox x:Name="DelayBox" Width="75" HorizontalAlignment="Right"/></DockPanel>
   <CheckBox x:Name="CleanupBox" Content="Turn off cheats and restore hooks when closing (recommended)" Margin="4,14,4,4"/>
   <TextBlock Text="Turning this off leaves remote patches active until the game exits and can make the next attachment require a game restart." Foreground="#FF8A98" TextWrapping="Wrap" Margin="24,0,4,14"/>
   <TextBlock Text="Performance" FontWeight="Bold"/>
   <DockPanel Margin="4,8"><TextBlock Text="Live coordinate refresh (milliseconds)" VerticalAlignment="Center"/><TextBox x:Name="RefreshBox" Width="75" HorizontalAlignment="Right"/></DockPanel>
   <DockPanel Margin="4"><TextBlock Text="Companion RAM trim threshold in MB (0 = off)" VerticalAlignment="Center"/><TextBox x:Name="MemoryBox" Width="75" HorizontalAlignment="Right"/></DockPanel>
   <TextBlock Text="RAM trimming is best-effort and affects only this companion, never the game." Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="4,4"/>
  </StackPanel>
  <WrapPanel Grid.Row="2" HorizontalAlignment="Right"><Button Content="Cancel" Click="Cancel_Click"/><Button Content="Save settings" Background="#285D4D" Click="Save_Click"/></WrapPanel>
 </Grid>
</Window>
