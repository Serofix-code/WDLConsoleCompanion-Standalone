<Window Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}" x:Class="WDLConsoleCompanion.CheatsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gameplay Cheats" Width="620" Height="560" MinWidth="500" MinHeight="420">
  <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,12"><TextBlock Text="GAMEPLAY CHEATS" FontSize="21" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
      <TextBlock Text="Single-player/offline only. Green means ON; red means OFF. Every patch is restored on detach." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/></StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsControl x:Name="CheatItems"><ItemsControl.ItemTemplate><DataTemplate>
      <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5" Margin="0,4" Padding="12">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition/><ColumnDefinition Width="100"/><ColumnDefinition Width="110"/><ColumnDefinition Width="95"/></Grid.ColumnDefinitions>
          <Ellipse Width="11" Height="11"><Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="#E05260"/><Style.Triggers><DataTrigger Binding="{Binding IsOn}" Value="True"><Setter Property="Fill" Value="#39D98A"/></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse>
          <StackPanel Grid.Column="1"><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/><TextBlock Text="{Binding Description}" Foreground="{DynamicResource MutedBrush}" FontSize="11"/></StackPanel>
          <TextBlock Grid.Column="2" Text="{Binding Risk}" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#F0A44B" FontSize="11" FontWeight="Bold" TextWrapping="Wrap"/>
          <TextBlock Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" FontWeight="Bold"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="OFF"/><Setter Property="Foreground" Value="#E05260"/><Style.Triggers><DataTrigger Binding="{Binding IsOn}" Value="True"><Setter Property="Text" Value="ON"/><Setter Property="Foreground" Value="#39D98A"/></DataTrigger><DataTrigger Binding="{Binding Name}" Value="teleport"><Setter Property="Text" Value="TOOL"/><Setter Property="Foreground" Value="#39D98A"/></DataTrigger><DataTrigger Binding="{Binding Name}" Value="clothes"><Setter Property="Text" Value="TOOL"/><Setter Property="Foreground" Value="#F0A44B"/></DataTrigger><DataTrigger Binding="{Binding IsAction}" Value="True"><Setter Property="Text" Value="ACTION"/><Setter Property="Foreground" Value="#39D98A"/></DataTrigger><DataTrigger Binding="{Binding IsAvailable}" Value="False"><Setter Property="Text" Value="UNDER DEVELOPMENT"/><Setter Property="Foreground" Value="#F0A44B"/><Setter Property="FontSize" Value="9"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
          <Button Grid.Column="4" Tag="{Binding Name}" Click="Toggle_Click"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Content" Value="Toggle"/><Style.Triggers><DataTrigger Binding="{Binding Name}" Value="teleport"><Setter Property="Content" Value="Open"/></DataTrigger><DataTrigger Binding="{Binding Name}" Value="clothes"><Setter Property="Content" Value="Open"/></DataTrigger><DataTrigger Binding="{Binding IsAction}" Value="True"><Setter Property="Content" Value="Add"/></DataTrigger><DataTrigger Binding="{Binding IsAvailable}" Value="False"><Setter Property="Content" Value="Details"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
        </Grid>
      </Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
    <TextBlock x:Name="Footer" Grid.Row="2" Margin="0,10,0,0" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
  </Grid>
</Window>
