<Window x:Class="WDLConsoleCompanion.CheatsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gameplay Cheats" Width="620" Height="560" MinWidth="500" MinHeight="420">
  <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,12"><TextBlock Text="GAMEPLAY CHEATS" FontSize="21" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
      <TextBlock Text="Single-player/offline only. Green means ON; red means OFF. Every patch is restored on detach." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/></StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsControl x:Name="CheatItems"><ItemsControl.ItemTemplate><DataTemplate>
      <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" Margin="0,4" Padding="12">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition/><ColumnDefinition Width="100"/><ColumnDefinition Width="80"/><ColumnDefinition Width="95"/></Grid.ColumnDefinitions>
          <Ellipse Width="11" Height="11"><Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="#E05260"/><Style.Triggers><DataTrigger Binding="{Binding IsOn}" Value="True"><Setter Property="Fill" Value="#39D98A"/></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse>
          <StackPanel Grid.Column="1"><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/><TextBlock Text="{Binding Description}" Foreground="{StaticResource MutedBrush}" FontSize="11"/></StackPanel>
          <TextBlock Grid.Column="2" Text="{Binding Risk}" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#F0A44B" FontSize="11" FontWeight="Bold" TextWrapping="Wrap"/>
          <TextBlock Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="OFF"/><Setter Property="Foreground" Value="#E05260"/><Style.Triggers><DataTrigger Binding="{Binding IsOn}" Value="True"><Setter Property="Text" Value="ON"/><Setter Property="Foreground" Value="#39D98A"/></DataTrigger><DataTrigger Binding="{Binding IsAvailable}" Value="False"><Setter Property="Text" Value="UNAVAILABLE"/><Setter Property="Foreground" Value="#8794A8"/><Setter Property="FontSize" Value="9"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
          <Button Grid.Column="4" Content="Toggle" Tag="{Binding Name}" IsEnabled="{Binding IsAvailable}" Click="Toggle_Click"/>
        </Grid>
      </Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
    <TextBlock x:Name="Footer" Grid.Row="2" Margin="0,10,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
  </Grid>
</Window>
