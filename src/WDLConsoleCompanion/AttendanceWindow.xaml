<Window Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}" x:Class="WDLConsoleCompanion.AttendanceWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Contract Schedule Editor" Width="1120" Height="620" MinWidth="820" MinHeight="440">
  <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,12"><TextBlock Text="CONTRACT ATTENDANCE SCHEDULES" FontSize="21" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="SUPER RISKY — only verified start time, end time, and priority fields are editable. Contract types and participants remain engine-owned." Foreground="#FF6878" TextWrapping="Wrap"/></StackPanel>
    <DataGrid x:Name="AttendanceGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False">
      <DataGrid.Columns><DataGridTextColumn Header="Contract" Binding="{Binding ContractType}" IsReadOnly="True" Width="240"/><DataGridTextColumn Header="Attendance" Binding="{Binding AttendanceType}" IsReadOnly="True" Width="*"/><DataGridTextColumn Header="Start hour" Binding="{Binding StartHour}" Width="90"/><DataGridTextColumn Header="End hour" Binding="{Binding EndHour}" Width="90"/><DataGridTextColumn Header="Priority" Binding="{Binding Priority}" Width="80"/><DataGridTextColumn Header="Contract ID" Binding="{Binding ContractId}" IsReadOnly="True" Width="150"/></DataGrid.Columns>
    </DataGrid>
    <DockPanel Grid.Row="2" Margin="0,12,0,0"><TextBlock x:Name="Footer" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/><Button DockPanel.Dock="Right" Content="Save selected schedule" Background="#4A202A" BorderBrush="#B64C5D" Click="Save_Click"/></DockPanel>
  </Grid>
</Window>
