<Window x:Class="WDLConsoleCompanion.MemoryScannerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Memory Scanner — Experimental" Width="920" Height="680" MinWidth="760" MinHeight="560"
        Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}">
  <Grid Margin="18">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,12">
      <TextBlock Text="MEMORY SCANNER — SUPER RISKY" FontSize="22" FontWeight="Bold" Foreground="#FF6878"/>
      <TextBlock Text="Find exact values or capture an initial baseline, then filter by changed, unchanged, increased, or decreased. A scan result is not proof of a noclip field: validate candidates repeatedly before writing." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
    </StackPanel>
    <Grid Grid.Row="1" Margin="0,0,0,10">
      <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="170"/><ColumnDefinition Width="120"/><ColumnDefinition Width="170"/><ColumnDefinition Width="100"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <TextBlock Text="Value type" VerticalAlignment="Center"/><ComboBox x:Name="TypeBox" Grid.Column="1" Margin="4"/>
      <TextBlock Grid.Column="2" Text="Scan scope" VerticalAlignment="Center"/><ComboBox x:Name="ScopeBox" Grid.Column="3" Margin="4"/>
      <TextBlock Grid.Column="4" Text="Value" VerticalAlignment="Center"/><TextBox x:Name="ValueBox" Grid.Column="5" Text="0" Margin="4"/>
    </Grid>
    <WrapPanel Grid.Row="2" Margin="0,0,0,10">
      <Button x:Name="ExactFirstButton" Content="First: Exact" Click="FirstExact_Click"/>
      <Button x:Name="UnknownFirstButton" Content="First: Unknown" Click="FirstUnknown_Click"/>
      <Button Content="Next: Exact" Click="NextExact_Click"/>
      <Button Content="Changed" Click="Changed_Click"/>
      <Button Content="Unchanged" Click="Unchanged_Click"/>
      <Button Content="Increased" Click="Increased_Click"/>
      <Button Content="Decreased" Click="Decreased_Click"/>
      <Button Content="New scan" Click="NewScan_Click"/>
      <Button x:Name="CancelButton" Content="Cancel" Click="Cancel_Click" IsEnabled="False"/>
    </WrapPanel>
    <DataGrid x:Name="ResultsGrid" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" CanUserAddRows="False" Background="{DynamicResource PanelBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Address" Binding="{Binding AddressText}" Width="210"/>
        <DataGridTextColumn Header="Current value" Binding="{Binding CurrentValue}" Width="*"/>
        <DataGridTextColumn Header="Previous value" Binding="{Binding PreviousValue}" Width="*"/>
      </DataGrid.Columns>
    </DataGrid>
    <Grid Grid.Row="4" Margin="0,10,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="180"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" Text="Ready. Unknown scans are capped at 256 MB / 2,000,000 candidates." TextWrapping="Wrap"/>
      <TextBlock Grid.Column="1" Text="Write selected:" Margin="12,0,4,0" VerticalAlignment="Center" Foreground="#FF6878"/>
      <TextBox x:Name="WriteValueBox" Grid.Column="2" Margin="4"/>
      <Button Grid.Column="3" Content="Write (risky)" Background="#4A202A" Click="Write_Click"/>
    </Grid>
  </Grid>
</Window>
