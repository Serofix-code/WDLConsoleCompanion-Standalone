<Window Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}" x:Class="WDLConsoleCompanion.ContractsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Contacts and Contracts" Width="1100" Height="620" MinWidth="780" MinHeight="420">
  <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,12"><Button DockPanel.Dock="Right" Content="Edit attendance schedules" Background="#4A202A" BorderBrush="#B64C5D" Click="EditSchedules_Click"/><StackPanel><TextBlock Text="CONTACTS / CONTRACT RELATIONSHIPS" FontSize="21" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="Types and participants are read-only. Verified schedule fields can be edited separately." Foreground="{DynamicResource MutedBrush}"/></StackPanel></DockPanel>
    <DataGrid x:Name="ContractGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowBackground="{DynamicResource RowBrush}" AlternatingRowBackground="{DynamicResource AlternateRowBrush}"><DataGrid.Columns><DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="*"/><DataGridTextColumn Header="Participant A" Binding="{Binding ParticipantA}" Width="260"/><DataGridTextColumn Header="Participant B" Binding="{Binding ParticipantB}" Width="260"/><DataGridTextColumn Header="Current" Binding="{Binding CurrentAttendances}" Width="80"/><DataGridTextColumn Header="Previous" Binding="{Binding PreviousAttendances}" Width="80"/><DataGridTextColumn Header="Contract ID" Binding="{Binding ContractId}" Width="150"/></DataGrid.Columns></DataGrid>
    <TextBlock x:Name="Footer" Grid.Row="2" Margin="0,10,0,0" Foreground="{DynamicResource MutedBrush}"/>
  </Grid>
</Window>
