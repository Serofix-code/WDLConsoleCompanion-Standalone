<Window Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}" x:Class="WDLConsoleCompanion.AppearanceWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Structured Appearance" Width="1050" Height="680" MinWidth="760" MinHeight="480">
  <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,12"><CheckBox x:Name="DefaultsBox" DockPanel.Dock="Right" Content="Edit wardrobe defaults" Checked="ModeChanged" Unchecked="ModeChanged" VerticalAlignment="Center"/><StackPanel><TextBlock Text="STRUCTURED APPEARANCE — FORMAT V12" FontSize="21" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/><TextBlock x:Name="FormatText" Foreground="{DynamicResource MutedBrush}"/></StackPanel></DockPanel>
    <DataGrid x:Name="FieldGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" RowBackground="{DynamicResource RowBrush}" AlternatingRowBackground="{DynamicResource AlternateRowBrush}">
      <DataGrid.Columns><DataGridTextColumn Header="Component" Binding="{Binding DisplayName}" Width="170"/><DataGridTemplateColumn Header="Readable value" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding Options}" DisplayMemberPath="Display" SelectedValuePath="Value" SelectedValue="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" IsTextSearchEnabled="True" TextSearch.TextPath="Display" MaxDropDownHeight="300"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="Resolved" Binding="{Binding ResolvedName}" Width="280"/></DataGrid.Columns>
    </DataGrid>
    <DockPanel Grid.Row="2" Margin="0,12,0,0"><TextBlock x:Name="Footer" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/><Button DockPanel.Dock="Right" Content="Save selected component (risky)" Background="#4A202A" BorderBrush="#B64C5D" Click="Save_Click"/></DockPanel>
  </Grid>
</Window>
