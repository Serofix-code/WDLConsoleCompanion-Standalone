<Window Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}" x:Class="WDLConsoleCompanion.StatisticsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Operative Statistics" Width="1040" Height="720" MinWidth="780" MinHeight="560">
  <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,12"><TextBlock Text="OPERATIVE STATISTICS" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="Edit core statistics or any of the 24 known demographic, career, voice, identity, and schedule values. Every write is revalidated and rolled back on failure." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/></StackPanel>
    <TabControl Grid.Row="1">
      <TabItem Header="Core statistics">
        <Grid Margin="16"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="48"/><RowDefinition Height="48"/><RowDefinition Height="58"/><RowDefinition Height="90"/><RowDefinition Height="90"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBlock Text="Age" VerticalAlignment="Center"/><TextBox x:Name="AgeBox" Grid.Column="1" Padding="9"/>
          <TextBlock Grid.Row="1" Text="Income" VerticalAlignment="Center"/><TextBox x:Name="IncomeBox" Grid.Row="1" Grid.Column="1" Padding="9"/>
          <TextBlock Grid.Row="2" Text="NPC status" VerticalAlignment="Center"/><ComboBox x:Name="StatusBox" Grid.Row="2" Grid.Column="1" DisplayMemberPath="Value" SelectedValuePath="Key" Padding="9"/>
          <TextBlock Grid.Row="3" Text="Country / region tag" VerticalAlignment="Center"/><TextBox x:Name="CountryBox" Grid.Row="3" Grid.Column="1" IsReadOnly="True" TextWrapping="Wrap" VerticalContentAlignment="Center"/>
          <TextBlock Grid.Row="4" Text="Displayed birthplace city" VerticalAlignment="Top" Margin="0,9,0,0"/><TextBox x:Name="BirthplaceBox" Grid.Row="4" Grid.Column="1" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
          <TextBlock Grid.Row="5" Text="Primary biography event" VerticalAlignment="Top" Margin="0,9,0,0"/><TextBox x:Name="PrimaryBiographyBox" Grid.Row="5" Grid.Column="1" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
          <StackPanel Grid.Row="6" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0"><Button Content="Edit recent events / city" Click="Events_Click"/><Button Content="Save core statistics (risky)" Background="#4A3020" BorderBrush="#D8843E" Click="SaveCore_Click"/></StackPanel>
        </Grid>
      </TabItem>
      <TabItem Header="All demographic statistics (24)">
        <Grid Margin="10"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <DataGrid x:Name="FieldGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" SelectionUnit="FullRow" Background="{DynamicResource PanelBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}" RowBackground="{DynamicResource RowBrush}" AlternatingRowBackground="{DynamicResource AlternateRowBrush}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Statistic" Binding="{Binding DisplayName}" IsReadOnly="True" Width="190"/>
              <DataGridTemplateColumn Header="Known value — select by readable name" Width="290"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding Options}" DisplayMemberPath="Display" SelectedItem="{Binding SelectedOption, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsAvailable}" IsTextSearchEnabled="True" TextSearch.TextPath="Display" MaxDropDownHeight="300"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
              <DataGridTextColumn Header="Resolved name" Binding="{Binding ResolvedName}" IsReadOnly="True" Width="220"/>
              <DataGridTextColumn Header="Raw hexadecimal value" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="240"/>
              <DataGridTextColumn Header="Risk" Binding="{Binding Risk}" IsReadOnly="True" Width="90"/>
              <DataGridTextColumn Header="Meaning" Binding="{Binding Description}" IsReadOnly="True" Width="*"/>
            </DataGrid.Columns>
          </DataGrid>
          <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0"><Button Content="Save selected statistic (high risk)" Background="#4A202A" BorderBrush="#B64C5D" Click="SaveMetadata_Click"/></StackPanel>
        </Grid>
      </TabItem>
    </TabControl>
    <DockPanel Grid.Row="2" Margin="0,10,0,0"><TextBlock x:Name="Footer" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/><Button DockPanel.Dock="Right" Content="Refresh all" Click="Refresh_Click"/></DockPanel>
  </Grid>
</Window>
