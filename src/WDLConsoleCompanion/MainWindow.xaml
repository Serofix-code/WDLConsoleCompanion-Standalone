<Window Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}" x:Class="WDLConsoleCompanion.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WDL Console Companion" Width="960" Height="620" MinWidth="700" MinHeight="420"
        Closing="Window_Closing">
  <Grid Margin="18">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,14">
      <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
        <Button Content="Operatives" Click="OperativesButton_Click"/>
        <Button Content="Cheats" Click="CheatsButton_Click"/>
        <Button Content="Scanner" Click="ScannerButton_Click"/>
        <Button Content="Shortcuts" Click="ShortcutsButton_Click"/>
        <Button Content="Settings" Click="SettingsButton_Click"/>
        <Button x:Name="ManualInjectButton" Content="Manual Inject" Click="ManualInjectButton_Click"/>
      </WrapPanel>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="#657083" Margin="0,0,9,0"/>
        <TextBlock x:Name="StatusText" Text="DETACHED" Foreground="{DynamicResource MutedBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
        <TextBlock x:Name="AutoInjectStatus" Text="AUTO-INJECT ON" Foreground="#7F8DA3" FontSize="11" Margin="16,0,0,0" VerticalAlignment="Center"/>
      </StackPanel>
    </DockPanel>
    <Grid Grid.Row="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
      <DockPanel Margin="0,0,0,6">
        <TextBlock Text="EVENT CONSOLE" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" VerticalAlignment="Center"/>
        <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
          <Button Content="Copy all" Click="CopyConsole_Click" Padding="10,4"/>
          <Button Content="Clear" Click="ClearConsole_Click" Padding="10,4"/>
          <Button Content="Save .txt" Click="SaveConsole_Click" Padding="10,4"/>
        </WrapPanel>
      </DockPanel>
      <TextBox x:Name="LogText" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" AcceptsTab="True"
               VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
               FontFamily="Cascadia Mono,Consolas" FontSize="14" TextWrapping="NoWrap"
               Background="{DynamicResource PanelBrush}" Foreground="{DynamicResource TextBrush}"
               BorderBrush="{DynamicResource BorderBrush}" Padding="14"/>
    </Grid>
    <Grid Grid.Row="2" Margin="0,12,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <TextBlock Text=">" Foreground="{DynamicResource AccentBrush}" FontFamily="Consolas" FontSize="20" Margin="4,2,10,0"/>
      <TextBox x:Name="CommandInput" Grid.Column="1" FontFamily="Cascadia Mono,Consolas" FontSize="15" Padding="10,7" KeyDown="CommandInput_KeyDown"/>
    </Grid>
  </Grid>
</Window>
