<Window Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}" x:Class="WDLConsoleCompanion.OperativesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Operative Studio" Width="1280" Height="720" MinWidth="900" MinHeight="500">
  <Grid Margin="16">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,12">
      <WrapPanel Width="760" HorizontalAlignment="Right" DockPanel.Dock="Right">
        <Button Content="Refresh" Click="Refresh_Click"/>
        <Button Content="Save changes" Click="Save_Click"/>
        <Button Content="Perks" Background="#4A202A" BorderBrush="#B64C5D" Click="Perks_Click"/>
        <Button Content="Statistics" Click="Statistics_Click"/>
        <Button Content="Recent events / city" Click="Events_Click"/>
        <Button Content="Appearance studio" Background="#4A202A" BorderBrush="#B64C5D" Click="Appearance_Click"/>
        <Button Content="Advanced metadata" Background="#4A3020" BorderBrush="#D8843E" Click="Advanced_Click"/>
        <Button Content="Contacts" Click="Contracts_Click"/>
        <Button Content="Remove" Background="#402029" BorderBrush="#7A3342" Click="Remove_Click"/>
      </WrapPanel>
      <StackPanel><TextBlock Text="OPERATIVE STUDIO" FontSize="21" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
        <TextBlock Text="Select an operative, then open a focused editor. Orange and red controls modify risky data." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/></StackPanel>
    </DockPanel>
    <DataGrid x:Name="RosterGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
              SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
              Background="{DynamicResource PanelBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}"
              RowBackground="{DynamicResource RowBrush}" AlternatingRowBackground="{DynamicResource AlternateRowBrush}" HorizontalGridLinesBrush="{DynamicResource GridLineBrush}">
      <DataGrid.Resources>
        <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="{DynamicResource HeaderBrush}"/><Setter Property="Foreground" Value="{DynamicResource HeaderTextBrush}"/><Setter Property="Padding" Value="10,8"/></Style>
        <Style TargetType="DataGridCell"><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="8,5"/></Style>
      </DataGrid.Resources>
      <DataGrid.Columns>
        <DataGridTextColumn Header="#" Binding="{Binding Index}" IsReadOnly="True" Width="55"/>
        <DataGridTextColumn Header="First name" Binding="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
        <DataGridTextColumn Header="Surname" Binding="{Binding Surname, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
        <DataGridComboBoxColumn x:Name="AvailabilityColumn" Header="Availability" SelectedValueBinding="{Binding Availability, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Value" DisplayMemberPath="Label" Width="120"/>
        <DataGridComboBoxColumn x:Name="OriginColumn" Header="Origin" SelectedValueBinding="{Binding Origin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Value" DisplayMemberPath="Label" Width="145"/>
        <DataGridTextColumn Header="Operative ID" Binding="{Binding IdHex}" IsReadOnly="True" Width="190"/>
        <DataGridTextColumn Header="Name loc ID" Binding="{Binding FirstNameLocId}" IsReadOnly="True" Width="110"/>
        <DataGridTextColumn Header="Surname loc ID" Binding="{Binding SurnameLocId}" IsReadOnly="True" Width="120"/>
      </DataGrid.Columns>
    </DataGrid>
    <TextBlock x:Name="Footer" Grid.Row="2" Margin="2,10,0,0" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
  </Grid>
</Window>
